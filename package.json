{
  "name": "better",
  "productName": "Better",
  "version": "1.0.1",
  "description": "Personal discipline and life tracking. Fully offline, fully local.",
  "main": "./out/main/index.js",
  "author": "ahmedbm068",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "start": "electron-vite preview",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "deploy": "npm run build:web && npx wrangler deploy --config server/wrangler.toml",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "postinstall": "node scripts/gen-icons.mjs && electron-builder install-app-deps",
    "smoke": "esbuild tests/smoke.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --external:better-sqlite3 --alias:@shared=./src/shared --alias:@main=./src/main --outfile=out/smoke.cjs && electron out/smoke.cjs",
    "migration-check": "esbuild tests/migration.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --external:better-sqlite3 --alias:@shared=./src/shared --alias:@main=./src/main --outfile=out/migration.cjs && electron out/migration.cjs",
    "sync-check": "esbuild tests/sync.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --external:better-sqlite3 --alias:@shared=./src/shared --alias:@main=./src/main --outfile=out/sync.cjs && electron out/sync.cjs",
    "server-check": "esbuild tests/server.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --external:better-sqlite3 --alias:@shared=./src/shared --alias:@main=./src/main --outfile=out/server.cjs && electron out/server.cjs",
    "syncservice-check": "esbuild tests/syncservice.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --external:better-sqlite3 --alias:@shared=./src/shared --alias:@main=./src/main --outfile=out/syncservice.cjs && electron out/syncservice.cjs"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "electron-updater": "^6.8.9",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "adhan": "^4.4.3",
    "electron": "42.10.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
